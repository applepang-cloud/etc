{
  "name": "family-photos-worker",
  "version": "1.0.0",
  "description": "가족 앨범 API (Cloudflare Workers + R2 + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p .",
    "db:migrate:local": "wrangler d1 migrations apply family-photos --local",
    "db:migrate": "wrangler d1 migrations apply family-photos --remote",
    "build:web": "cd ../app && flutter build web --release --no-web-resources-cdn",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.2"
  },
  "private": true,
  "type": "module"
}
